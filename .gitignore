/work/
/dist/
/.build/
/.swiftpm/
/iPad*/

# Never publish vendor binaries, installers, archives or signing material.
*.app/
*.framework/
*.xcarchive/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.exe
*.dll
*.dylib
*.so
*.a
*.o
